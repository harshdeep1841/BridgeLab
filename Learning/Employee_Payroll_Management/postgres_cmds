--to display employee details using join
SELECT
    e.employee_id,
    e.employee_name,
    d.department_name,
    s.salary
FROM payroll.employees e
JOIN payroll.departments d
    ON e.department_id = d.department_id
JOIN payroll.salaries s
    ON e.employee_id = s.employee_id;

--to display departmentwise salary expenditure using CTE

WITH department_salary AS (
    SELECT
        d.department_name,
        SUM(s.salary) AS total_salary
    FROM payroll.employees e
    JOIN payroll.departments d
        ON e.department_id = d.department_id
    JOIN payroll.salaries s
        ON e.employee_id = s.employee_id
    GROUP BY d.department_name
)
SELECT *
FROM department_salary;

-- employees earning more then department avg

SELECT
    e.employee_name,
    s.salary,
    e.department_id
FROM payroll.employees e
JOIN payroll.salaries s
    ON e.employee_id = s.employee_id
WHERE s.salary > (
    SELECT AVG(s2.salary) FROM payroll.employees e2
    JOIN payroll.salaries s2
        ON e2.employee_id = s2.employee_id
    WHERE e2.department_id = e.department_id
);

--calculate net salary

CREATE OR REPLACE FUNCTION payroll.calculate_net_salary(
    p_salary NUMERIC,
    p_bonus NUMERIC,
    p_deduction NUMERIC
)
RETURNS NUMERIC
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN p_salary + p_bonus - p_deduction;
END;
$$;


select payroll.calculate_net_salary(50000 , 5000 , 2000);


--employee payslip

CREATE OR REPLACE VIEW payroll.employee_payslip AS
SELECT
    mp.payroll_id,
    e.employee_name,
    d.department_name,
    mp.salary_month,
    mp.basic_salary,
    mp.bonus,
    mp.deduction,
    mp.net_salary
FROM payroll.monthly_payroll mp
JOIN payroll.employees e
    ON mp.employee_id = e.employee_id
JOIN payroll.departments d
    ON e.department_id = d.department_id;

select * from payroll.employee_payslip;

--prevent duplicate payrolls 

CREATE OR REPLACE FUNCTION payroll.check_duplicate_payroll()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN

    IF EXISTS (

        SELECT 1
        FROM payroll.monthly_payroll
        WHERE employee_id = NEW.employee_id
          AND salary_month = NEW.salary_month

    ) THEN

        RAISE EXCEPTION
        'Salary already processed for this employee and month';

    END IF;
    RETURN NEW;
END;
$$;

--i will use this trigger while inserting new payroll

CREATE TRIGGER trg_duplicate_payroll
BEFORE INSERT ON payroll.monthly_payroll
FOR EACH ROW
EXECUTE FUNCTION payroll.check_duplicate_payroll();


