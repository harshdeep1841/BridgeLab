CREATE SCHEMA payroll;

CREATE TABLE payroll.departments (
    department_id SERIAL PRIMARY KEY,
    department_name VARCHAR(100) NOT NULL UNIQUE
);

CREATE TABLE payroll.employees (
    employee_id SERIAL PRIMARY KEY,
    employee_name VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE,
    department_id INT NOT NULL,

    FOREIGN KEY (department_id)
        REFERENCES payroll.departments(department_id)
);

CREATE TABLE payroll.salaries (
    salary_id SERIAL PRIMARY KEY,
    employee_id INT NOT NULL,
    salary NUMERIC(10,2) NOT NULL CHECK (salary > 0),
    effective_date DATE NOT NULL,

    FOREIGN KEY (employee_id)
        REFERENCES payroll.employees(employee_id)
);


CREATE TABLE payroll.attendance (
    attendance_id SERIAL PRIMARY KEY,
    employee_id INT NOT NULL,
    attendance_date DATE NOT NULL,
    status VARCHAR(20) NOT NULL,

    FOREIGN KEY (employee_id)
        REFERENCES payroll.employees(employee_id),

    CHECK (status IN ('Present', 'Absent', 'Leave'))
);

CREATE TABLE payroll.bonuses (
    bonus_id SERIAL PRIMARY KEY,
    employee_id INT NOT NULL,
    bonus_amount NUMERIC(10,2) NOT NULL CHECK (bonus_amount >= 0),
    bonus_month DATE NOT NULL,

    FOREIGN KEY (employee_id)
        REFERENCES payroll.employees(employee_id)
);

CREATE TABLE payroll.deductions (
    deduction_id SERIAL PRIMARY KEY,
    employee_id INT NOT NULL,
    deduction_amount NUMERIC(10,2) NOT NULL CHECK (deduction_amount >= 0),
    deduction_month DATE NOT NULL,

    FOREIGN KEY (employee_id)
        REFERENCES payroll.employees(employee_id)
);


CREATE TABLE payroll.monthly_payroll (
    payroll_id SERIAL PRIMARY KEY,

    employee_id INT NOT NULL,

    salary_month DATE NOT NULL,

    basic_salary NUMERIC(10,2) NOT NULL,
    bonus NUMERIC(10,2) DEFAULT 0,
    deduction NUMERIC(10,2) DEFAULT 0,
    net_salary NUMERIC(10,2) NOT NULL,

    FOREIGN KEY (employee_id)
        REFERENCES payroll.employees(employee_id),

    UNIQUE (employee_id, salary_month)
);


