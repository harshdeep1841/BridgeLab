CREATE OR REPLACE PROCEDURE payroll.process_monthly_salary(
    p_month DATE
)
LANGUAGE plpgsql
AS $$
DECLARE
    emp RECORD;
    payroll_cursor CURSOR FOR
        SELECT *
        FROM temp_monthly_payroll;
BEGIN
    OPEN payroll_cursor;
    LOOP
        FETCH NEXT FROM payroll_cursor INTO emp;
        EXIT WHEN NOT FOUND;
        INSERT INTO payroll.monthly_payroll
(
    employee_id,
    salary_month,
    basic_salary,
    bonus,
    deduction,
    net_salary
)
VALUES
(
    emp.employee_id,
    p_month,
    emp.basic_salary,
    emp.bonus,
    emp.deduction,
    payroll.calculate_net_salary(
        emp.basic_salary,
        emp.bonus,
        emp.deduction
    )
);

    END LOOP;
    CLOSE payroll_cursor;
END;
$$;


