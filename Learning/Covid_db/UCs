--**Stored Procedure:**

--6. Create a stored procedure that returns the total number of recovered cases for a given country and date.

create or replace procedure total_recovered
(p_country_id INT,
p_date DATE
)
language plpgsql
as $$
DECLARE v_total_recovered bigint;

BEGIN
select recovered into v_total_recovered from global_covid_stats
where country_id = p_country_id AND p_date = report_date;

RAISE NOTICE 'Total recovered cases: %' , v_total_recovered;

END;
$$

call total_recovered(1 , '2020-12-31');
--7. Design a stored procedure to update the number of deaths for a specific country and date.

CREATE OR REPLACE PROCEDURE update_deaths(
    p_country_id INT,
    p_date DATE,
    p_deaths BIGINT
)
LANGUAGE plpgsql
AS $$
BEGIN
    UPDATE global_covid_stats
    SET deaths = p_deaths
    WHERE country_id = p_country_id
      AND report_date = p_date;

    RAISE NOTICE 'Deaths updated successfully';
END;
$$;

call update_deaths(1 , '2020-12-31' , 1400);
