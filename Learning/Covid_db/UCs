--**User-Defined Functions (UDF):**

--16. Develop a UDF to calculate the mortality rate (deaths / confirmed cases * 100) for a given country.

create or replace function calculate_mortality_rate
(
p_country_id int
)
returns numeric
language plpgsql

as $$

declare
deaths BIGINT;
confirmed_cases BIGINT;
mortality_rate numeric;

begin
	
	select SUM(gcs.deaths)  , SUM(gcs.confirmed) into deaths , confirmed_cases from
	global_covid_stats gcs where p_country_id = gcs.country_id ;
	
	mortality_rate := (deaths :: numeric / NULLIF(confirmed_cases , 0)) * 100;
	
	return mortality_rate;
	
end
$$;

select calculate_mortality_rate(1);

--17. Create a UDF to determine the recovery rate (recovered / confirmed cases * 100) for a specific date.

create or replace function calculate_recovery_rate
(
p_date DATE
)
returns numeric
language plpgsql
as $$

declare 
recovered BIGINT;
confirmed_cases BIGINT;
recovery_rate numeric;

begin
	
	select SUM(gcs.recovered) , SUM(gcs.confirmed) into recovered , confirmed_cases from 
	global_covid_stats gcs where p_date = gcs.report_date ;
	
	recovery_rate := (recovered :: numeric / nullif(confirmed_cases , 0)) * 100;
	
	return recovery_rate;
	
end
$$

select calculate_recovery_rate('2020-12-31');

